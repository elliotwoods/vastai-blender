{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    // The @electron-toolkit base turns this off, which leaves strict mode
    // silently treating untyped parameters as `any`.
    "noImplicitAny": true,
    "types": ["electron-vite/node"]
  }
}
